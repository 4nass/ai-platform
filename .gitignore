# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.claude

# Local per-target index: vector store + dependency graph cache, and the
# target's own declared test command (see core/context/manager.py,
# core/orchestrator/test_runner.py). Generated fresh per repo `--repo`
# points at.
.ai-platform/

# Engine telemetry (local analytical memory, shared across every --repo target)
telemetry.sqlite
telemetry.sqlite-wal
telemetry.sqlite-shm
# Durable job queue (submitted runs, their lifecycle, and crash recovery)
jobs.sqlite
jobs.sqlite-wal
jobs.sqlite-shm
